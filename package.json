{
  "name": "inlay",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --no-error-on-unmatched-pattern --fix",
    "lint:selftest": "node scripts/lint-selftest.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "check": "pnpm lint && pnpm lint:selftest && pnpm format:check && pnpm typecheck && pnpm test",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.30.3"
}
